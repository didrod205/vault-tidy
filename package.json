    "test": "node esbuild.test.mjs && node --test test-dist/*.mjs"
  },
  "author": "E:LAB",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild-wasm": "^0.24.0",
    "lucide": "^1.77.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0"
  }
}
