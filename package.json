{
  "name": "vault-tidy",
  "version": "0.1.0",
  "description": "Clean up tags, properties and text across your Obsidian vault with previews and one-click undo.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
